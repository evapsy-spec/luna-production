# База: SQLite-файл для разработки
DATABASE_FILE=./luna.db

# Секрет для подписи сессионных cookie — в продакшене заменить!
SESSION_SECRET=

# Ainur Connect API
# Токен генерируется в AinurPOS → Integration → Connect API → «Generate a token»
# Для Luna Production достаточно уровня доступа Readonly.
AINUR_API_BASE=https://connect.ainur.app/api/v4
AINUR_API_TOKEN=
