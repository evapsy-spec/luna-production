# База: SQLite-файл для разработки
DATABASE_FILE=./luna.db

# Секрет для подписи сессионных cookie — в продакшене заменить!
SESSION_SECRET=

# Ainur Connect API
# Токен генерируется в AinurPOS → Integration → Connect API → «Generate a token»
# Для Luna Production достаточно уровня доступа Readonly.
AINUR_API_BASE=https://connect.ainur.app/api/v4
AINUR_API_TOKEN=

# Луна-бот (Telegram)
# Токен от @BotFather — вставить самому, не через Луну
TELEGRAM_BOT_TOKEN=
BOT_HEALTH_PORT=3200
BOT_HEALTH_HOST=127.0.0.1
# Время вечерней сводки, UTC. По умолчанию 11:00 UTC = 18:00 по Таиланду
BOT_DIGEST_HOUR_UTC=11
BOT_DIGEST_MINUTE_UTC=0
# Watchdog: кому слать алерт, telegram user id через запятую
BOT_WATCHDOG_ALERT_CHAT_IDS=
BOT_HEALTH_URL=http://127.0.0.1:3200/health
