[Unit]
Description=Luna Production — синхронизация с Ainur каждое утро

[Timer]
# Сервер живёт в UTC. 23:30 UTC = 06:30 в Таиланде (там Ева и склады),
# 07:30 на Бали. Уже после ночного бэкапа в 19:30 UTC: если синхронизация
# притащит из Ainur что-то не то, вчерашняя копия базы цела.
#
# Само расписание внутри приложения (настройка sync_schedule) должно совпадать
# с этим временем — скрипт показывает его на странице. Меняешь здесь — поменяй
# и там, иначе Ева увидит одно, а произойдёт другое.
OnCalendar=*-*-* 23:30:00
Persistent=true
RandomizedDelaySec=300
Unit=luna-sync.service

[Install]
WantedBy=timers.target
