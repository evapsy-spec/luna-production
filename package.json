{
  "name": "luna-production",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f luna.db luna.db-wal luna.db-shm && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "dev:lan": "next dev -p 3000 -H 0.0.0.0",
    "start:lan": "next start -p 3000 -H 0.0.0.0",
    "db:fresh": "tsx scripts/fresh.ts",
    "sync:now": "tsx --env-file=.env scripts/sync-now.ts",
    "sync:scheduled": "tsx --env-file=.env scripts/sync-scheduled.ts",
    "db:counts": "tsx --env-file=.env scripts/counts.ts",
    "ainur:inspect": "tsx --env-file=.env scripts/inspect-ainur.ts",
    "ainur:tree": "tsx --env-file=.env scripts/ainur-tree.ts",
    "ainur:sales": "tsx --env-file=.env scripts/inspect-sales.ts",
    "ainur:nosku": "tsx --env-file=.env scripts/inspect-nosku.ts",
    "import:johnny": "tsx --env-file=.env scripts/import-johnny.ts",
    "ainur:probe": "tsx --env-file=.env scripts/probe-history.ts",
    "ainur:backfill": "tsx --env-file=.env scripts/backfill-sales.ts",
    "sku:exclude": "tsx --env-file=.env scripts/exclude-sku.ts",
    "mcp": "tsx --env-file=.env mcp/server.ts",
    "bot": "tsx --env-file=.env bot/server.ts",
    "bot:watchdog": "tsx --env-file=.env scripts/bot-watchdog.ts",
    "bot:add-user": "tsx --env-file=.env scripts/bot-add-user.ts",
    "test": "tsx --test src/lib/brands.test.ts src/lib/transfers/logic.test.ts src/lib/ops-scripts.test.ts src/lib/ainur/resolve-brand.test.ts"
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "grammy": "^1.45.1",
    "jose": "^6.2.9",
    "next": "^16.3.1",
    "pkce-challenge": "^5.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "private": true
}
